# =============================================================================
# Syncrate — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Service Role key bypasses RLS — NEVER expose to client
# Only use in server-side trusted code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Syncrate
NODE_ENV=development

# -----------------------------------------------------------------------------
# AI Platform — Anthropic Claude (Sprint 8)
# -----------------------------------------------------------------------------
# Required to enable AI features (assistant, OCR, forecasting, recommendations,
# insights, smart search, smart reports). Server-only — never exposed to the
# client. When unset, AI features return a clean "not configured" error.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (sensible defaults are baked in):
#   AI_DEFAULT_MODEL — reasoning/assistant/vision/reports (default: claude-opus-4-8)
#   AI_FAST_MODEL    — high-volume extraction e.g. search intent (default: claude-haiku-4-5)
# AI_DEFAULT_MODEL=claude-opus-4-8
# AI_FAST_MODEL=claude-haiku-4-5

# -----------------------------------------------------------------------------
# Email — Resend (Phase 1)
# Get from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@syncrate.com

# -----------------------------------------------------------------------------
# Payments — Razorpay (Phase 1)
# Get from: https://dashboard.razorpay.com/app/keys
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_...

# -----------------------------------------------------------------------------
# Analytics — PostHog (optional)
# Get from: https://posthog.com
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Error Tracking — Sentry (optional)
# Get from: https://sentry.io
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=syncrate
# SENTRY_PROJECT=syncrate-web
