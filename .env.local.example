# =============================================================================
# Syncrate — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Service Role key bypasses RLS — NEVER expose to client
# Only use in server-side trusted code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Syncrate
NODE_ENV=development

# -----------------------------------------------------------------------------
# AI Providers (Phase 3 — Sprint 8)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...

# -----------------------------------------------------------------------------
# Email — Resend (Phase 1)
# Get from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@syncrate.com

# -----------------------------------------------------------------------------
# Payments — Razorpay (Phase 1)
# Get from: https://dashboard.razorpay.com/app/keys
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_...

# -----------------------------------------------------------------------------
# Analytics — PostHog (optional)
# Get from: https://posthog.com
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Error Tracking — Sentry (optional)
# Get from: https://sentry.io
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=syncrate
# SENTRY_PROJECT=syncrate-web
